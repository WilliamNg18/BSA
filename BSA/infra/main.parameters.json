{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": { "value": "${AZURE_ENV_NAME}" },
    "location": { "value": "${AZURE_LOCATION}" },
    "authMode": { "value": "${AZURE_AUTH_MODE=required}" },
    "authClientId": { "value": "${AZURE_AUTH_CLIENT_ID}" },
    "allowedPrincipalIds": { "value": ["${AZURE_ALLOWED_PRINCIPAL_ID}"] },
    "owner": { "value": "${AZURE_ALLOWED_PRINCIPAL_ID}" }
  }
}